POSTGRES_DB=employee_hr
POSTGRES_USER=hr
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200

# HS256 needs at least 32 characters. Generate a secure random key.
JWT_SECRET=

# Empty disables POST /internal/bootstrap/company
BOOTSTRAP_KEY=

# prod = schema only, seed = demo data, prod,seed = both
LIQUIBASE_CONTEXTS=prod,seed

# Empty in Docker. Use acme only when calling the API as bare localhost:8080
TENANT_DEV_DEFAULT_SLUG=

# Spring profile: prod (VPS) or dev (local)
SPRING_PROFILES_ACTIVE=prod

# Tenant subdomain routing — wildcard DNS *.workline.casa -> VPS IP
TENANT_BASE_DOMAIN=workline.casa
TENANT_TRUST_FORWARDED_HOST=true
FRONTEND_TENANT_URL_TEMPLATE=http://{slug}.workline.casa

# Mail (optional — leave empty to disable email features)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@workline.casa
